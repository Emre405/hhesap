# Firebase Yapılandırma Bilgileri
# Firebase Console > Project Settings > General > Your Apps kısmından bu değerleri kopyalayabilirsiniz.
VITE_FIREBASE_API_KEY=AIzaSyDemoKeyReplaceWithYourOwnKey
VITE_FIREBASE_AUTH_DOMAIN=hesap-takip-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hesap-takip-demo
VITE_FIREBASE_STORAGE_BUCKET=hesap-takip-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
